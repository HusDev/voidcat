rules_version = '2';

// Voidcat Cloud files: users/{uid}/files/{id} is one document's file, sealed on the device before upload (the same
// "VCAT" format the Mac stores), so the bucket only ever holds locked bytes. Each person reaches only their own.
service firebase.storage {
  match /b/{bucket}/o {
    function owner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid}/files/{id} {
      allow read, delete: if owner(uid);
      allow create, update: if owner(uid)
        && request.resource.size <= 200 * 1024 * 1024
        && request.resource.contentType == 'application/octet-stream';
    }

    // Everything else is closed.
    match /{path=**} {
      allow read, write: if false;
    }
  }
}
