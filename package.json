{
  "name": "voidcat",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "typecheck": "tsc --noEmit && tsc --noEmit -p mcp && tsc --noEmit -p scripts && tsc --noEmit -p api",
    "lint": "oxlint src mcp scripts api",
    "test": "vitest run",
    "build:mcp": "bun build mcp/server.ts --compile --minify --outfile src-tauri/binaries/voidcat-mcp-$(rustc -vV | sed -n 's/host: //p')",
    "privacy": "bun scripts/privacy-guard.ts",
    "demo": "VOIDCAT_DIR=\"$HOME/Library/Application Support/dev.hus.voidcat-demo\" tauri dev"
  },
  "dependencies": {
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource-variable/outfit": "^5.3.0",
    "@fontsource/caveat": "5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@headlessui/react": "^2.2.10",
    "@huggingface/transformers": "4.3.0",
    "@mdxeditor/editor": "4.3.2",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@openrouter/ai-sdk-provider": "^3.1.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-autostart": "2.7.0",
    "@tauri-apps/plugin-dialog": "~2",
    "@tauri-apps/plugin-notification": "~2",
    "@tauri-apps/plugin-opener": "^2",
    "ai": "^7.0.137",
    "docx": "9.8.1",
    "fflate": "0.7.5",
    "firebase": "12.19.0",
    "lucide-react": "^1.55.0",
    "mdast-util-from-markdown": "2.1.0",
    "mdast-util-gfm": "3.1.0",
    "micromark-extension-gfm": "3.0.0",
    "pdf-lib": "1.17.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "react-router": "^8.4.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.3.3",
    "tesseract.js": "7.0.0",
    "unpdf": "^1.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@google/genai": "2.27.0",
    "@tauri-apps/cli": "^2",
    "@types/bun": "^1.4.3",
    "@types/mdast": "4.0.4",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "firebase-admin": "14.5.0",
    "oxlint": "^1.87.0",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vitest": "^5.0.4"
  },
  "license": "MIT",
  "overrides": {
    "qs": "^6.16.1",
    "@grpc/grpc-js": "^1.14.5"
  }
}
