rules_version = '2';

// Voidcat Cloud: each person reaches only their own library, and the server only ever holds sealed bytes.
// users/{uid}             when the library was made + a sealed check phrase (tests a typed recovery key)
// users/{uid}/records/{id} one sealed record each (a document, fact, folder, chat, label…) with a version number
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow get: if owner(uid);
      allow create: if owner(uid)
        && request.resource.data.keys().hasOnly(['createdAt', 'check'])
        && request.resource.data.createdAt == request.time
        && request.resource.data.check is bytes
        && request.resource.data.check.size() <= 256;
      // A new check only when a Mac takes over an empty cloud library with its own key; deleting the account goes
      // through the server.
      allow update: if owner(uid)
        && request.resource.data.keys().hasOnly(['createdAt', 'check'])
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.check is bytes
        && request.resource.data.check.size() <= 256;
      allow delete: if false;

      match /records/{id} {
        allow read: if owner(uid);
        allow create, update: if owner(uid)
          && request.resource.data.keys().hasOnly(['data', 'v', 'updatedAt'])
          && request.resource.data.data is bytes
          && request.resource.data.data.size() <= 900000
          && request.resource.data.v is int
          && request.resource.data.updatedAt == request.time;
        allow delete: if owner(uid);
      }
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
